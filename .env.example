# Names only. Copy to `.env/.env` (a directory named `.env/` already exists in
# the Wisconsin pipeline for the GEE key) and fill in real values there.
# `.env/` is gitignored. Never commit values, and never paste them into chat or
# an issue. In cloud sessions and CI, set these as platform secrets instead.

# dev | prod. The migration runner refuses prod without --confirm-prod.
APP_ENV=dev

# Neon (Postgres + PostGIS). Two separate projects, dev and prod.
# Direct (non-pooled) connection, owner role: migrations only.
DATABASE_URL_MIGRATE=
# Direct connection, ingest_writer login: scheduled ingestion jobs.
DATABASE_URL_INGEST=
# Pooled connection (host contains "-pooler"), api_reader login: FastAPI.
DATABASE_URL_API=
# Pooled connection, analyst_readonly login: Streamlit workbench.
DATABASE_URL_ANALYST=
# Throwaway PostGIS database for DB tests (CI service container). Never a Neon URL.
TEST_DATABASE_URL=

# Contact address placed in the HTTP User-Agent of every connector.
CONNECTOR_CONTACT=

# Per-source keys, read by each connector as it is built. Fixture mode needs none.
CENSUS_API_KEY=
SOCRATA_APP_TOKEN=
